<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same 100,000 flights as the development database (scripts/seed-flights.sql), inside the exe -->
    <EmbeddedResource Include="..\..\scripts\seed-flights.sql" LogicalName="seed-flights.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlyReservation.Api\FlyReservation.Api.csproj" />
  </ItemGroup>

</Project>
