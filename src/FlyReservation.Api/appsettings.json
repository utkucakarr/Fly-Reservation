{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/flyreservation-.log",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5343" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "PaymentService": {
    "BaseUrl": "http://localhost:5288/"
  },
  "Jwt": {
    "Issuer": "FlyReservation.Api",
    "Audience": "FlyReservation.Clients",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Reservations": {
    "PaymentWindow": "00:15:00",
    "ExpiryCheckInterval": "00:00:30"
  },
  "AllowedHosts": "*"
}
